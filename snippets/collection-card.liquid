{{ 'collection-card.css' | asset_url | stylesheet_tag }}

<a href="{{ collection.url }}" class="container__collection-card">
  <div class="card__img-wrapper">
    <img srcset="{{ image |  image_url: width: image.width  }}" loading="lazy">
  </div>
  <div>
    {%- if title != blank -%}
      <h2 class="{{ class_size }} card__title {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in {% endif %}">
        {{ title }}
      </h2>
    {%- endif -%}
  </div>
</a>