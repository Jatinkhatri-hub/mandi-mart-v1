{{ 'collection-card.css' |  stylesheet_tag }}

<a
  href="{{ collection.url }}"
  class="container__collection-card">
  <div class="card__img-wrapper">
    <img 
      srcset="{{ image |  image_url: width: image.width  }}"
      loading="lazy"
      >
  </div>
  <div>
      {%- if title != blank -%}
        <h1 class="{{ class_size }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in {% endif %}">
          {{ title }}
        </h1>
      {%- endif -%}
    </div>
</a>